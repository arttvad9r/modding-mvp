{
  "name": "@project/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/api.test.ts test/readiness.test.ts test/ui.test.ts test/ui-client.test.ts",
    "test:service-integration": "vitest run test/api.integration.test.ts",
    "start": "tsx src/main.ts",
    "user:create": "tsx src/user-create-cli.ts",
    "start:prod": "node --conditions=production dist/src/main.js",
    "user:create:prod": "node --conditions=production dist/src/user-create-cli.js"
  },
  "dependencies": {
    "@project/domain": "workspace:*",
    "@project/service-core": "workspace:*",
    "@project/service-postgres": "workspace:*",
    "@project/service-s3": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@project/factorio-service-executor": "workspace:*",
    "@project/llm": "workspace:*",
    "@project/worker": "workspace:*",
    "drizzle-orm": "0.45.4"
  }
}
