# Planner provider: openai | ollama-cloud | zai
LLM_PROVIDER=zai

# Optional model override. Dev/eval defaults: Z.ai = glm-5.3-flash; Ollama Cloud = deepseek-v4.1-flash:cloud.
# LLM_MODEL overrides every provider-specific default.
# LLM_MODEL=

# Ollama Cloud: https://ollama.com/v1 (OpenAI-compatible)
OLLAMA_API_KEY=
# OLLAMA_MODEL=deepseek-v4.1-flash:cloud
# OLLAMA_BASE_URL=https://ollama.com/v1

# Z.ai is the current dev/test default. Coding Plan keys use a separate quota/endpoint.
ZAI_API_KEY=
ZAI_MODEL=glm-5.3-flash
ZAI_API_MODE=coding
# General/prepaid alternative: ZAI_API_MODE=general and https://api.z.ai/api/paas/v4
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# OpenAI production/benchmark adapter (Responses API).
OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional cost accounting overrides for the selected provider.
# LLM_INPUT_USD_PER_MILLION=
# LLM_OUTPUT_USD_PER_MILLION=

# M6 worker/service infrastructure. The values below match infra/compose.integration.yaml only.
# Production secrets/URLs must come from the deployment environment.
# DATABASE_URL=postgresql://project:project-dev-password@127.0.0.1:55432/modding_mvp
# PG_BOSS_SCHEMA=project_pgboss
# S3_ENDPOINT=http://127.0.0.1:59090
# S3_BUCKET=modding-artifacts
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=project-dev-access
# S3_SECRET_ACCESS_KEY=project-dev-secret
# S3_FORCE_PATH_STYLE=true
# FACTORIO_BIN=/absolute/path/to/factorio
# WORKER_CONCURRENCY=1
# WORKER_HEARTBEAT_MS=30000
# WORKER_STALE_AFTER_MS=300000
# WORKER_RECOVERY_INTERVAL_MS=60000
