# Planner provider: openai | ollama-cloud | zai
LLM_PROVIDER=ollama-cloud

# Optional model override. Current dev/eval defaults: Ollama Cloud = glm-5.3-flash; Z.ai = glm-5.3-flash.
# LLM_MODEL overrides every provider-specific default.
# LLM_MODEL=

# Ollama Cloud: https://ollama.com/v1 (OpenAI-compatible)
OLLAMA_API_KEY=
OLLAMA_MODEL=glm-5.3-flash
# OLLAMA_BASE_URL=https://ollama.com/v1

# Z.ai remains the tested fallback. Coding Plan keys use a separate quota/endpoint.
ZAI_API_KEY=
ZAI_MODEL=glm-5.3-flash
ZAI_API_MODE=coding
# General/prepaid alternative: ZAI_API_MODE=general and https://api.z.ai/api/paas/v4
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Worker-only provider chain. Local Planner/Repair CLI commands continue to use LLM_PROVIDER above.
# LLM_PRIMARY_PROVIDER=ollama-cloud
# LLM_FALLBACK_PROVIDER=zai

# OpenAI production/benchmark adapter (Responses API).
OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Deadline for one complete provider call (headers and body), in ms. Default: 120000.
# LLM_REQUEST_TIMEOUT_MS=

# Optional cost accounting overrides for the selected provider.
# LLM_INPUT_USD_PER_MILLION=
# LLM_OUTPUT_USD_PER_MILLION=

# M6 worker/service infrastructure. The values below match infra/compose.integration.yaml only.
# Production secrets/URLs must come from the deployment environment.
# DATABASE_URL=postgresql://project:project-dev-password@127.0.0.1:55432/modding_mvp
# PG_BOSS_SCHEMA=project_pgboss
# S3_ENDPOINT=http://127.0.0.1:59090
# Web only: internal endpoint for the /health/ready storage check when S3_ENDPOINT is a public signing name.
# S3_READINESS_ENDPOINT=http://object-storage:8333
# S3_BUCKET=modding-artifacts
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=project-dev-access
# S3_SECRET_ACCESS_KEY=project-dev-secret
# S3_FORCE_PATH_STYLE=true
# FACTORIO_BIN=/absolute/path/to/factorio
# WORKER_CONCURRENCY=1
# WORKER_HEARTBEAT_MS=30000
# WORKER_STALE_AFTER_MS=300000
# WORKER_RECOVERY_INTERVAL_MS=60000
# Generation execution and artifact publication deadlines; together with the heartbeat grace (60 s)
# they must stay below the pg-boss job expiry (900 s).
# WORKER_EXECUTION_TIMEOUT_MS=600000
# WORKER_PUBLISH_TIMEOUT_MS=120000
# Queued records older than this are failed (retryable) when their pg-boss job no longer exists/finished.
# WORKER_ORPHAN_QUEUED_AFTER_MS=60000
# Liveness file touched after every successful recovery pass; the worker image sets it and its
# HEALTHCHECK fails when the file is older than WORKER_HEALTH_MAX_AGE_S.
# WORKER_HEALTH_FILE=/tmp/worker-health
# WORKER_HEALTH_MAX_AGE_S=180
# Whole Factorio cache install deadline (lock wait, download retries, verification, extraction).
# FACTORIO_INSTALL_TIMEOUT_S=900
# Private-beta HTTP API. Use a deployment-secret random salt (>=16 chars).
# API_HOST=127.0.0.1
# API_PORT=3000
# API_IP_HASH_SALT=replace-with-random-deployment-secret
# API_TRUST_PROXY=false
# Interval for bounded deletion of rate-limit buckets older than 24 h. Default: 900000.
# RATE_LIMIT_CLEANUP_INTERVAL_MS=900000
