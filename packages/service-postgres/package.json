{
  "name": "@project/service-postgres",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "production": "./dist/src/index.js",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run test/adapters.test.ts test/kpis.test.ts",
    "test:integration": "vitest run test/postgres.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate-cli.ts",
    "kpis": "tsx src/kpi-cli.ts",
    "db:migrate:prod": "node --conditions=production dist/src/migrate-cli.js",
    "kpis:prod": "node --conditions=production dist/src/kpi-cli.js"
  },
  "dependencies": {
    "@project/service-core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.37.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "0.31.11"
  }
}
