# Copy outside the repository for the real deployment and chmod 600.
WEB_IMAGE=modding-mvp-web:beta
WORKER_IMAGE=modding-mvp-worker:beta

POSTGRES_PASSWORD=replace-with-random-password
API_IP_HASH_SALT=replace-with-random-salt-at-least-16-chars

S3_BUCKET=modding-artifacts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-random-access-key
S3_SECRET_ACCESS_KEY=replace-with-random-secret-key
# Tailscale Funnel terminates TLS on :8443 and forwards to loopback :8333.
S3_PUBLIC_ENDPOINT=https://helsinki-vps.example-tailnet.ts.net:8443

ZAI_API_KEY=replace-with-coding-plan-key
ZAI_MODEL=glm-5.3-flash
ZAI_API_MODE=coding
