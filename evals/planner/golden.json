ины. Размер стака 100. Рецепт: 2 стальные пластины и 5 пластиковых брусков дают 1 Усиленную пластину за 2 секунды, открыть технологией «Продвинутая обработка материалов 2». Затем создай новую машину «Усиленная печь» на основе электрической печи: скорость 4, энергопотребление 500 кВт, 4 слота модулей, размер стака 50. Рецепт: 1 электрическая печь, 10 Усиленных пластин и 5 процессоров, 6 секунд. Открыть технологией «Продвинутая обработка материалов 2».","expected":{"status":"supported","capability":"mixed","changes":[{"type":"new_item","baseItemName":"steel-plate","name":"custom-reinforced-plate","displayName":"Усиленная пластина","stackSize":100,"recipeCraftingTime":2,"recipeIngredients":[{"itemName":"steel-plate","amount":2},{"itemName":"plastic-bar","amount":5}],"recipeResultAmount":1,"unlock":{"type":"existing_technology","technologyName":"advanced-material-processing-2"}},{"type":"new_machine","machineType":"furnace","basePrototypeName":"electric-furnace","name":"custom-reinforced-furnace","displayName":"Усиленная печь","speed":4,"energyUsageKw":500,"moduleSlots":4,"itemStackSize":50,"recipeCraftingTime":6,"recipeIngredients":[{"itemName":"electric-furnace","amount":1},{"itemName":"custom-reinforced-plate","amount":10},{"itemName":"processing-unit","amount":5}],"unlock":{"type":"existing_technology","technologyName":"advanced-material-processing-2"}}]}},{"id":"content-undeclared-custom-item","prompt":"Create a new electric furnace called Quantum Furnace whose recipe uses 10 custom quantum plates, but do not create the quantum plates.","expected":{"status":"unsupported"}}]
