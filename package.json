{
  "name": "modding-mvp",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r --if-present test:integration",
    "factorio:setup": "bash scripts/setup-factorio.sh",
    "factorio:test": "pnpm --filter @project/factorio-harness cli --",
    "mod:build": "pnpm --filter @project/factorio-generator cli --",
    "prompt:plan": "pnpm --filter @project/agent-core cli --",
    "planner:eval": "pnpm --filter @project/agent-core eval --",
    "repair:eval": "pnpm --filter @project/agent-core repair:eval --",
    "prompt:build": "pnpm --filter @project/agent-core pipeline --",
    "prompt:feedback": "pnpm --filter @project/agent-core feedback --"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
