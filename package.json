{
  "name": "modding-mvp",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r --if-present test:integration",
    "factorio:setup": "bash scripts/setup-factorio.sh",
    "postgres:setup": "bash scripts/setup-postgres-dev.sh",
    "factorio:test": "pnpm --filter @project/factorio-harness cli --",
    "mod:build": "pnpm --filter @project/factorio-generator cli --",
    "prompt:plan": "pnpm --filter @project/agent-core cli --",
    "planner:eval": "pnpm --filter @project/agent-core eval --",
    "repair:eval": "pnpm --filter @project/agent-core repair:eval --",
    "prompt:build": "pnpm --filter @project/agent-core pipeline --",
    "prompt:feedback": "pnpm --filter @project/agent-core feedback --",
    "service:infra:up": "docker compose -f infra/compose.integration.yaml up -d --pull missing",
    "service:infra:down": "docker compose -f infra/compose.integration.yaml down -v --remove-orphans",
    "test:service-integration": "bash scripts/with-service-infra.sh bash scripts/run-service-integration.sh",
    "worker:start": "pnpm --filter @project/worker start",
    "db:migrate": "pnpm --filter @project/service-postgres db:migrate",
    "api:start": "pnpm --filter @project/web start",
    "beta:user:create": "pnpm --filter @project/web user:create --",
    "beta:kpis": "pnpm --filter @project/service-postgres kpis"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
